---
layout: base.njk
---
{% set authorData = authors | selectattr("slug", "equalto", author) | first %}
{% set catData = categories | selectattr("slug", "equalto", category) | first %}

<div class="breadcrumb">
<a href="/">Home</a> / <a href="/categories/">Categories</a> / <a href="/categories/{{ category }}/">{{ catData.name if catData else category }}</a>
</div>

<article class="post-page">

{% if image %}
<img class="post-hero-img" src="{{ image }}" alt="{{ title }}">
{% endif %}

<span class="tag">{{ catData.name if catData else category }}</span>

<h1>{{ title }}</h1>

<div class="post-meta">
{% if authorData %}
<img class="author-avatar" src="{{ authorData.avatar }}" alt="{{ authorData.name }}">
<span>{{ authorData.name }}</span>
<span>·</span>
{% endif %}
<span>{{ date | readableDate }}</span>
</div>

<div class="post-body">
{{ content | safe }}
</div>

{% if videoUrl %}
<iframe src="{{ videoUrl }}" title="{{ title }}" allowfullscreen></iframe>
{% endif %}

{% if authorData %}
<div class="author-box">
<img src="{{ authorData.avatar }}" alt="{{ authorData.name }}">
<div>
<h4>{{ authorData.name }}</h4>
<p>{{ authorData.bio }}</p>
</div>
</div>
{% endif %}

</article>
